--- /dev/null
+++ b/tests/d3d12-shm-readback.c
@@ -0,0 +1,24 @@
+#include <assert.h>
+#include "render/gles2/shm-readback.h"
+
+int main(void) {
+    assert(gles2_named_d3d12("D3D12 (NVIDIA RTX A4000)"));
+    assert(!gles2_named_d3d12("llvmpipe (LLVM 19)"));
+    assert(!gles2_named_d3d12("D3D12 (Microsoft Basic Render Driver)"));
+    assert(!gles2_named_d3d12("D3D12 (WARP)"));
+    assert(!gles2_named_d3d12("D3D12 (Unknown)"));
+    assert(!gles2_named_d3d12("D3D12 ()"));
+    assert(!gles2_named_d3d12(NULL));
+    const uint8_t rgba[] = {200,20,10,111, 40,80,140,200};
+    uint8_t padded[16];
+    memset(padded, 7, sizeof(padded));
+    assert(gles2_rgba_to_bgrx(padded, 8, rgba, 1, 2, true));
+    const uint8_t expected[] = {10,20,200,111,7,7,7,7, 140,80,40,200,7,7,7,7};
+    assert(memcmp(padded, expected, sizeof(padded)) == 0);
+    assert(gles2_rgba_to_bgrx(padded, 4, rgba, 2, 1, true) == false);
+    assert(gles2_rgba_to_bgrx(padded, 8, rgba, 2, 1, false));
+    assert(padded[3] == 255 && padded[7] == 255);
+    assert(!gles2_rgba_to_bgrx(padded, 8, rgba, 0, 1, true));
+    assert(!gles2_rgba_to_bgrx(padded, SIZE_MAX, rgba, 1, 2, true));
+    return 0;
+}
