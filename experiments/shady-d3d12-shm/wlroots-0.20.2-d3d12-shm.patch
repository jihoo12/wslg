+bool gles2_buffer_readback(struct wlr_gles2_buffer *buffer) {
+	struct wlr_buffer *target = buffer->buffer;
+	void *dst;
+	uint32_t format;
+	size_t stride;
+	if (!wlr_buffer_begin_data_ptr_access(target, WLR_BUFFER_DATA_PTR_ACCESS_WRITE,
+			&dst, &format, &stride)) {
+		return false;
+	}
+	glBindFramebuffer(GL_FRAMEBUFFER, buffer->fbo);
+	GLint prev_pack;
+	glGetIntegerv(GL_PACK_ALIGNMENT, &prev_pack);
+	glPixelStorei(GL_PACK_ALIGNMENT, 4);
+	glReadPixels(0, 0, target->width, target->height, GL_RGBA, GL_UNSIGNED_BYTE,
+		buffer->rgba_readback);
+	glPixelStorei(GL_PACK_ALIGNMENT, prev_pack);
+
+	// Existing wlroots GLES/GBM passes arrange top as GL row 0. Preserve
+	// that same order rather than adding a glReadPixels-style Y flip.
+	bool ok = glGetError() == GL_NO_ERROR &&
+		(format == DRM_FORMAT_XRGB8888 || format == DRM_FORMAT_ARGB8888) &&
+		gles2_rgba_to_bgrx(dst, stride, buffer->rgba_readback, target->width,
+			target->height, format == DRM_FORMAT_ARGB8888);
+	wlr_buffer_end_data_ptr_access(target);
+	if (!ok) {
+		wlr_log(WLR_ERROR, "Failed to read back GLES2 output to wl_shm");
+	}
+	return ok;
+}
