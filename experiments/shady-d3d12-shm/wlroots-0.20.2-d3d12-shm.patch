+#ifndef WLR_GLES2_SHM_READBACK_H
+#define WLR_GLES2_SHM_READBACK_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <string.h>
+#include <strings.h>
+
+static inline bool gles2_named_d3d12(const char *name) {
+    if (!name || strncasecmp(name, "D3D12 (", 7) != 0) {
+        return false;
+    }
+    size_t len = strlen(name);
+    if (len <= 8 || name[len - 1] != ')') {
+        return false;
+    }
+    const char *reject[] = {"warp", "microsoft basic", "software",
+        "llvmpipe", "softpipe", "unknown", NULL};
+    for (const char **p = reject; *p; ++p) {
+        size_t n = strlen(*p);
+        for (const char *s = name + 7; *s; ++s) {
+            if (strncasecmp(s, *p, n) == 0) {
+                return false;
+            }
+        }
+    }
+    return true;
+}
+
+static inline bool gles2_rgba_to_bgrx(void *dst, size_t stride,
+        const uint8_t *src, size_t width, size_t height, bool keep_alpha) {
+    if (!dst || !src || width == 0 || height == 0 || width > SIZE_MAX / 4 ||
+            stride < width * 4 || height > SIZE_MAX / stride) {
+        return false;
+    }
+    for (size_t y = 0; y < height; ++y) {
+        uint8_t *row = (uint8_t *)dst + y * stride;
+        for (size_t x = 0; x < width; ++x, src += 4, row += 4) {
+            // ARGB8888/XRGB8888 on little-endian WSL2 hosts.
+            row[0] = src[2];
+            row[1] = src[1];
+            row[2] = src[0];
+            row[3] = keep_alpha ? src[3] : 255;
+        }
+    }
+    return true;
+}
+
+#endif
